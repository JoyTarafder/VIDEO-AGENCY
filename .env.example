# ── Site ────────────────────────────────────────────────────────────────────
# Canonical URL — used for metadata, Open Graph, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Scheduling link shown next to the inquiry form ("Book a 20-min intro call").
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/intro-call

# ── Database (MongoDB) ──────────────────────────────────────────────────────
# Atlas connection string or local instance.
# If unset, the API still accepts submissions but only logs them server-side
# (handy for first run — add a real URI before going live).
MONGODB_URI=

# ── Email (Nodemailer over SMTP) ────────────────────────────────────────────
# Works with any SMTP provider. For Resend use:
#   host smtp.resend.com / port 465 / user resend / pass <your API key>
# If unset, notifications are skipped and submissions are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VIDEO AGENCY <no-reply@yourdomain.com>"
# Where new inquiries are sent (comma-separated for multiple recipients).
CONTACT_TO=producer@yourdomain.com
